{
  "schemaVersion": 1,
  "corpusId": "trackdub-gpu-docs",
  "corpusVersion": "v0",
  "description": "Curated GPU/inference docs for Trackdub agents. Complements NVIDIA CUDA MCP; does not replace it.",
  "pin": {
    "sourceManifest": "runtime/trt-rtx-ep.manifest.json",
    "epAbiVersion": "0.5.0",
    "epAbiVersionLinux": "0.5.0",
    "cudaVariant": "cu13",
    "trtRtxRuntimeVersion": "1.7.1",
    "bundledWindowsLibs": [
      "onnxruntime_providers_nv_tensorrt_rtx.dll",
      "tensorrt_rtx_1_7.dll",
      "tensorrt_onnxparser_rtx_1_7.dll",
      "tensorrt_plugins.dll"
    ],
    "epDeviceName": "NvTensorRTRTXExecutionProvider",
    "releaseAssets": {
      "win-x64": "https://github.com/NVIDIA/TensorRT-RTX-EP-ABI/releases/download/v0.5.0/TensorRT-RTX-EP-ABI-v0.5.0-cu13.zip",
      "linux-x64": "https://github.com/NVIDIA/TensorRT-RTX-EP-ABI/releases/download/v0.5.0/TensorRT-RTX-EP-ABI-v0.5.0-cu13-linux-x86_64.zip"
    },
    "notes": [
      "Trackdub ships the standalone ORT EP ABI plugin, not the Windows ML catalog EP.",
      "DLL suffix _1_7 means TensorRT-RTX library lineage 1.7 (1.7.1) inside EP ABI 0.5.0 (Windows and Linux). EP ABI 0.5.0 lists ORT 1.25-1.30 as compatible; Trackdub runs it on ORT 1.31 (verified 2026-10-22).",
      "The Windows cu13 bundle has no cudart import (CUDA runtime statically linked); the Linux cu13 bundle ships libcudart.so.13.",
      "docs.nvidia.com/deeplearning/tensorrt-rtx/latest/ currently tracks newer product docs (1.7+). Prefer Trackdub reference docs for pin-specific behavior; treat /latest/ as upstream context, not a pin guarantee.",
      "GitHub EP ABI release notes are the pin-accurate changelog."
    ]
  },
  "policyPrecedence": [
    "trackdub-local",
    "ort-plugin-ep",
    "nvidia-tensorrt-rtx",
    "microsoft-winml"
  ],
