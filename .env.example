# AWS CPU job API. .NET reads these environment variables; it does not automatically load .env.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
AWS_REGION=us-west-2
Cloud__TableName=trackdub-poc-jobs
Cloud__BucketName=trackdub-poc-private-artifacts
Cloud__JwtIssuer=https://cognito-idp.REGION.amazonaws.com/POOL_ID
Cloud__JwtAudience=trackdub-poc-api
# Required for Cognito access tokens that omit aud:
Cloud__JwtClientId=APP_CLIENT_ID
Cloud__AllowedOrigins__0=https://APPROVED_PORTAL_ORIGIN
# Remains ineffective until one concrete scheduler adapter is selected and registered.
Cloud__ProcessingEnabled=false

# Supervisor task role uses the AWS SDK default credential chain. Never store access keys here.
# TRACKDUB_CLOUD_TABLE=trackdub-poc-jobs
# TRACKDUB_CLOUD_BUCKET=trackdub-poc-private-artifacts
# TRACKDUB_JOB_ID=trusted-job-uuid
# TRACKDUB_ATTEMPT_ID=trusted-attempt-uuid
# TRACKDUB_DISPATCH_ID=trusted-dispatch-uuid
# TRACKDUB_EXECUTION_ID=trusted-scheduler-execution-id

# Existing CLI: use --model-directory /data/models and explicit provider/preset options.
# Local SQLite is project state, never the durable cloud job database.
# TRACKDUB_ENGINE_CACHE_ROOT=/data/engine-cache
# MODELS_CACHE_DIR, AUTO_DOWNLOAD_MODELS, DATABASE_PATH and ONNX_PROVIDER are not CLI controls.
# No API key, Cloudflare API, D1 or R2 runtime configuration is used by this API.
